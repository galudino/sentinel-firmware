# Doxyfile for sentinel-firmware (#53)
#
# Curated (non-default keys only; unset keys use Doxygen defaults). Generates
# the API reference from the in-tree `\brief`/`\details` comments into
# docs/doxygen/ (gitignored). Run from the repo root:
#
#     doxygen Doxyfile
#
# Coverage note: WARN_IF_UNDOCUMENTED is ON so the doc-backfill gap is visible.
# The end-of-Phase-I sweep (#53) drives that warning count to zero; until then a
# clean *run* (exit 0, HTML produced) is the bar, not a clean warning log.
#
# Verified against Doxygen 1.11.0.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "Sentinel Firmware"
PROJECT_BRIEF          = "BLE-connected embedded telemetry & diagnostics platform (PSoC 6)"
OUTPUT_DIRECTORY       = docs/doxygen
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
TAB_SIZE               = 4
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

#---------------------------------------------------------------------------
# Build / extraction
#---------------------------------------------------------------------------
# EXTRACT_ALL stays NO so undocumented entities surface as warnings (the #53
# coverage goal), rather than being silently synthesised into the output.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = NO
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
GENERATE_TODOLIST      = YES
MAX_INITIALIZER_LINES  = 30

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = Sentinel/src README.md docs/architecture
FILE_PATTERNS          = *.hpp *.cpp *.h *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md

# Reference-only / generated / scaffold trees are excluded from the sweep.
EXCLUDE_PATTERNS       = */GeneratedSource/* \
                         */mtb_shared/* \
                         */libs/* \
                         */build/* \
                         */driver_file_template/*
EXCLUDE_SYMLINKS       = YES

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#---------------------------------------------------------------------------
# Preprocessing (firmware headers lean on a few attribute-ish macros)
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
PREDEFINED             = __cplusplus \
                         SENTINEL_TESTBENCH=0

#---------------------------------------------------------------------------
# Output formats
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = NO
# Render any formulas client-side (MathJax) so a LaTeX install is not required.
USE_MATHJAX            = YES

#---------------------------------------------------------------------------
# Diagrams (no Graphviz on the toolchain host -> built-in diagrams only)
#---------------------------------------------------------------------------
HAVE_DOT               = NO
